export global AppState {
    pure callback lookup(string, bool) -> string;
    pure callback diagnostic(string, bool) -> string;
    pure callback theme-color(string, bool) -> color;
    public pure function tr(key: string) -> string { return lookup(key, chinese); }
    public pure function localize(message: string) -> string { return diagnostic(message, chinese); }
    in-out property <string> system-error;
    out property <string> display-error: error != "" ? localize(error) : "";
    out property <string> settings-error: system-error != "" ? localize(system-error) : "";
    in-out property <bool> window-active;
    in-out property <bool> dark: true;
    in-out property <bool> chinese: true;
    in-out property <float> scale: 1;
    in-out property <bool> running;
    in-out property <bool> diagnose-input;
    callback input-trace(string);
    in-out property <bool> can-start: true;
    in-out property <int> capture;
    in-out property <int> input-key;
    in-out property <int> action;
    in-out property <int> cursor;
    in-out property <int> theme-mode;
    in-out property <int> scale-index;
    in-out property <int> language-mode;
    in-out property <bool> wheel;
    in-out property <string> start-hotkey: "F8";
    in-out property <string> custom-key;
    in-out property <string> coordinate: "0,0";
    in-out property <string> period: "0.010";
    in-out property <string> press-duration: "0.005";
    in-out property <string> jitter: "0";
    in-out property <string> status;
    in-out property <string> error;
    in-out property <string> version;
    in-out property <string> author;
    callback edit-option(int, int);
    callback edit-number(int, string);
    callback begin-capture(int);
    callback select-page(int);
    callback request-page(int);
    in-out property <string> script-file;
    in-out property <[string]> script-files;
    callback script-select(string);
    in-out property <string> script-hotkey: "F8";
    in-out property <bool> script-capture;
    in-out property <string> script-status;
    in-out property <string> script-error;
    callback script-begin-capture();
    callback script-pick-coordinate();
    callback script-file-action(int);
    in-out property <string> paste-text;
    in-out property <bool> paste-capture;
    in-out property <string> paste-hotkey: "F8";
    in-out property <string> paste-press: "0.005";
    in-out property <string> paste-interval: "0.010";
    in-out property <int> paste-strategy: 0;
    in-out property <string> paste-status;
    in-out property <string> paste-error;
    callback paste-begin-capture();
    callback paste-edit-strategy(int);
    callback paste-edit-number(int, string);
    callback open-repository();
    callback open-manual();
    callback open-slint();
    callback open-licenses();

    out property <color> window: theme-color("window", dark);
    out property <color> border: theme-color("border", dark);
    out property <color> panel: theme-color("panel", dark);
    out property <color> title: theme-color("title", dark);
    out property <color> row: theme-color("row", dark);
    out property <color> label: theme-color("label", dark);
    out property <color> hover: theme-color("hover", dark);
    out property <color> selected: theme-color("selected", dark);
    out property <color> text: theme-color("text", dark);
    out property <color> muted: theme-color("muted", dark);
    out property <color> accent: theme-color("accent", dark);
    out property <color> danger: theme-color("danger", dark);
    out property <color> green: theme-color("green", dark);
    out property <color> yellow: theme-color("yellow", dark);
    out property <color> coordinate-border: theme-color("coordinate-border", dark);
    out property <color> coordinate-text: theme-color("coordinate-text", dark);
    out property <color> inactive: theme-color("inactive", dark);
    out property <color> on-accent: theme-color("on-accent", dark);
    out property <string> font: "FloriInputUI";
}
